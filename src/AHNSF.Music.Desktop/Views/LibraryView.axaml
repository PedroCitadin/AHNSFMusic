<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AHNSF.Music.Desktop" xmlns:controls="using:AHNSF.Music.Desktop.Controls" x:Class="AHNSF.Music.Desktop.Views.LibraryView">
  <UserControl.Resources><local:CurrentTrackConverter x:Key="CurrentTrackConverter"/></UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Summary and folder actions -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding LibraryStatistics}" Classes="subheading"/><TextBlock Text="{Binding MusicDirectory}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MusicDirectory}"/></StackPanel>
      <Button Grid.Column="1" Content="Atualizar biblioteca" Classes="ghost" Command="{Binding RefreshCommand}" Margin="10,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Reconciliar a pasta agora; arquivos inalterados não são relidos"/>
      <Button Grid.Column="2" Content="Selecionar pasta" Command="{Binding ChooseDirectoryCommand}" VerticalAlignment="Center" ToolTip.Tip="Escolher a pasta local com os MP3"/>
    </Grid>
    <!-- Search and filters -->
    <Grid Grid.Row="1" ColumnDefinitions="2.2*,*,*,*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
      <Grid>
        <TextBox x:Name="LibrarySearch" Padding="36,6,34,6" ToolTip.Tip="Ctrl+F pesquisa; caixa e acentos são ignorados" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Pesquisar título, artista, álbum ou arquivo" AutomationProperties.Name="Pesquisar na biblioteca"/>
        <Path Classes="icon" Data="{StaticResource SearchIcon}" Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
        <Button Classes="ghost" Content="✕" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearchCriteria}" ToolTip.Tip="Limpar pesquisa e filtros" AutomationProperties.Name="Limpar pesquisa e filtros" MinHeight="26" Padding="8,2" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <ComboBox Grid.Column="1" ItemsSource="{Binding ArtistOptions}" SelectedItem="{Binding SelectedArtist, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="Filtrar por artista" AutomationProperties.Name="Filtrar por artista"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <ComboBox Grid.Column="2" ItemsSource="{Binding AlbumOptions}" SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="Filtrar por álbum" AutomationProperties.Name="Filtrar por álbum"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="Ordenar por" AutomationProperties.Name="Ordenar por"/>
      <ToggleButton Grid.Column="4" Content="↓ Decrescente" IsChecked="{Binding Descending, Mode=TwoWay}" ToolTip.Tip="Inverter a ordenação" AutomationProperties.Name="Decrescente"/>
    </Grid>
    <!-- Selection actions (wrap on narrow windows) -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
      <StackPanel Spacing="1" VerticalAlignment="Center" Margin="2,0,12,0"><TextBlock Text="{Binding ResultsText}" Classes="caption"/><TextBlock Text="{Binding LibrarySelectionText}" Classes="caption accent" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding TargetPlaylist, Mode=TwoWay}" Width="200" PlaceholderText="Playlist de destino" Margin="0,0,6,4" ToolTip.Tip="Playlist que receberá as músicas selecionadas" AutomationProperties.Name="Playlist de destino"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Button Content="Adicionar à playlist" Command="{Binding AddToPlaylistCommand}" Margin="0,0,6,4" ToolTip.Tip="Adicionar as selecionadas à playlist de destino"/>
        <Button Content="Tocar a seguir" Command="{Binding AddAsNextCommand}" ToolTip.Tip="Adicionar selecionadas como próximas na fila" Margin="0,0,6,4"/>
        <Button Content="+ Fila" Command="{Binding AddToQueueCommand}" Margin="0,0,0,4" ToolTip.Tip="Adicionar selecionadas ao final da fila" AutomationProperties.Name="Adicionar ao final da fila"/>
      </WrapPanel>
    </Grid>
    <!-- Track list with aligned header -->
    <Border Grid.Row="3" Classes="list">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Classes="libraryRow" ColumnDefinitions="52,22,*,0.55*,0.55*,64" Margin="13,8,10,8">
          <TextBlock Grid.Column="2" Text="TÍTULO" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="ARTISTA" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="ÁLBUM" Classes="eyebrow"/><TextBlock Grid.Column="5" Text="DURAÇÃO" Classes="eyebrow" HorizontalAlignment="Right" Margin="0,0,6,0"/>
        </Grid>
        <Border Grid.Row="1" Classes="divider" Margin="8,0,8,4"/>
        <ListBox Grid.Row="2" x:Name="MusicList" ItemsSource="{Binding Tracks}" SelectionMode="Multiple" SelectedItems="{Binding SelectedLibraryTracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Músicas da biblioteca" ToolTip.Tip="Duplo clique reproduz • Ctrl/Shift para seleção múltipla • botão direito para ações">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><Grid Classes="libraryRow" ClipToBounds="True" ColumnDefinitions="52,22,*,0.55*,0.55*,64">
            <controls:ArtworkView Classes="rowArt" CacheKey="{Binding ArtworkCacheKey}" HorizontalAlignment="Left"/>
            <Path Grid.Column="1" Classes="icon accentIcon" Data="{StaticResource EqualizerIcon}" Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip.Tip="Música atual"><Path.IsVisible><MultiBinding Converter="{StaticResource CurrentTrackConverter}"><Binding/><Binding Path="$parent[Window].DataContext.CurrentTrack"/></MultiBinding></Path.IsVisible></Path>
            <StackPanel Grid.Column="2" Spacing="1" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/><TextBlock Text="{Binding FileName}" Classes="caption" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding Artist}" Classes="muted" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="{Binding Album}" Classes="muted" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="{Binding DurationText}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" IsVisible="{Binding ShowLibraryLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="160" Height="4" MinHeight="4"/>
          <TextBlock Text="Indexando a pasta musical…" Classes="muted" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" IsVisible="{Binding ShowEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24" MaxWidth="420">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center"><Path Classes="icon accentIcon" Data="{StaticResource LibraryIcon}" Width="24" Height="24"/></Border>
          <TextBlock Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
          <Button Content="Limpar pesquisa e filtros" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearchCriteria}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
