<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AHNSF.Music.Desktop.Controls" x:Class="AHNSF.Music.Desktop.Views.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Margin="0,0,14,0">
    <Border Classes="card alert" Padding="14,12" IsVisible="{Binding HasOperationalAlert}"><Grid ColumnDefinitions="26,*"><Path Classes="icon" Data="{StaticResource AlertIcon}" Stroke="{StaticResource WarningBrush}" VerticalAlignment="Top"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Atenção operacional" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="{Binding OperationalAlert}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Grid ColumnDefinitions="3*,2*">
      <Border Classes="card" Margin="0,0,7,0"><Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto">
        <controls:ArtworkView CacheKey="{Binding CurrentTrack.ArtworkCacheKey}" Width="80" Height="80" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="AGORA NO PLAYER" Classes="eyebrow"/><TextBlock Text="{Binding CurrentTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentArtist}" Classes="muted" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"><Run Text="Playlist / origem: "/><Run Text="{Binding ActiveOrigin}"/></TextBlock></StackPanel>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"><Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,12,6" ToolTip.Tip="Estado atual do player"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding PlayerStateIcon}" Foreground="{Binding PlayerStateColor}"/><TextBlock Text="{Binding PlayerStateLabel}" Foreground="{Binding PlayerStateColor}" FontWeight="SemiBold"/></StackPanel></Border><Button Content="Abrir fila" Command="{Binding NavigateCommand}" CommandParameter="Fila" Margin="0,0,8,6"/><Button Content="Abrir biblioteca" Command="{Binding NavigateCommand}" CommandParameter="Biblioteca" Margin="0,0,0,6"/></WrapPanel>
      </Grid></Border>
      <Border Grid.Column="1" Classes="card" Margin="7,0,0,0"><StackPanel Spacing="6">
        <TextBlock Text="{Binding RuleContext}" Classes="eyebrow"/><TextBlock Text="{Binding RuleLabel}" Classes="heading" TextWrapping="Wrap"/>
        <TextBlock Text="PRÓXIMA TRANSIÇÃO" Classes="eyebrow" Margin="0,6,0,0"/><TextBlock Text="{Binding NextAction}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="{Binding ExpectedEnd}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
        <Button Content="Ver programação semanal" Command="{Binding NavigateCommand}" CommandParameter="Programação" HorizontalAlignment="Left" Margin="0,6,0,0"/>
      </StackPanel></Border>
    </Grid>
    <UniformGrid Columns="3">
      <Border Classes="card" Margin="0,0,7,0"><StackPanel Spacing="6"><TextBlock Text="BIBLIOTECA" Classes="eyebrow"/><TextBlock Text="{Binding LibraryTotalLabel}" Classes="heading"/><TextBlock Text="{Binding LibraryHealth}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Classes="card" Margin="7,0,7,0"><StackPanel Spacing="6"><TextBlock Text="PLAYLISTS" Classes="eyebrow"/><TextBlock Text="{Binding PlaylistTotalLabel}" Classes="heading"/><TextBlock Text="Repertórios salvos localmente" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Classes="card" Margin="7,0,0,0"><StackPanel Spacing="6"><TextBlock Text="OPERAÇÃO" Classes="eyebrow"/><TextBlock Text="{Binding ModeLabel}" Classes="heading"/><TextBlock Text="{Binding AutomationLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
    </UniformGrid>
    <Border Classes="card"><StackPanel Spacing="6"><TextBlock Text="HISTÓRICO OPERACIONAL" Classes="eyebrow"/><TextBlock Text="{Binding HistoryDashboard}" TextWrapping="Wrap" Classes="muted"/><Button Content="Abrir Histórico" Command="{Binding NavigateCommand}" CommandParameter="Histórico" HorizontalAlignment="Left"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
