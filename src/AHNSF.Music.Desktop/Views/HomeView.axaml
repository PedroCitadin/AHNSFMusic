<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AHNSF.Music.Desktop.Controls" x:Class="AHNSF.Music.Desktop.Views.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18" Margin="0,0,14,8">
    <Border Classes="card alert" Padding="16,12" IsVisible="{Binding HasOperationalAlert}"><Grid ColumnDefinitions="30,*"><Path Classes="icon warningIcon" Data="{StaticResource AlertIcon}" VerticalAlignment="Top"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Atenção operacional" FontWeight="SemiBold" Classes="warning"/><TextBlock Text="{Binding OperationalAlert}" TextWrapping="Wrap"/></StackPanel></Grid></Border>

    <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
      <!-- Now playing -->
      <Border Classes="hero">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
          <controls:ArtworkView Classes="heroArt" CacheKey="{Binding CurrentTrack.ArtworkCacheKey}" CornerRadius="10" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding NowPlayingEyebrow}" Classes="eyebrow accent"/>
            <TextBlock Text="{Binding CurrentTitle}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LetterSpacing="-0.2"/>
            <TextBlock Text="{Binding CurrentArtist}" Classes="muted" FontSize="15" TextTrimming="CharacterEllipsis"/>
            <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"><Run Text="Origem: "/><Run Text="{Binding ActiveOrigin}" FontWeight="SemiBold"/></TextBlock>
            <WrapPanel Margin="0,10,0,0">
              <Button Classes="accent large" Command="{Binding PlayPauseCommand}" Margin="0,0,10,6" AutomationProperties.Name="{Binding PlayLabel}">
                <StackPanel Orientation="Horizontal" Spacing="8"><Grid><Path Classes="icon filled" Data="{StaticResource PlayIcon}" IsVisible="{Binding !IsPlaying}" Width="13" Height="13"/><Path Classes="icon" Data="{StaticResource PauseIcon}" IsVisible="{Binding IsPlaying}" StrokeThickness="2.6" Width="13" Height="13"/></Grid><TextBlock Text="{Binding PlayLabel}"/></StackPanel>
              </Button>
              <Button Content="Abrir fila" Command="{Binding NavigateCommand}" CommandParameter="Fila" Classes="large" Margin="0,0,10,6"/>
              <Border Classes="badge" VerticalAlignment="Center" Margin="0,0,0,6" ToolTip.Tip="Estado atual do player"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding PlayerStateIcon}" Foreground="{Binding PlayerStateColor, Converter={StaticResource ToneBrush}}"/><TextBlock Text="{Binding PlayerStateLabel}" Foreground="{Binding PlayerStateColor, Converter={StaticResource ToneBrush}}"/></StackPanel></Border>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Schedule -->
      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="PROGRAMAÇÃO" Classes="eyebrow"/><Border Grid.Column="1" Classes="badge accent"><TextBlock Text="{Binding ModeLabel}"/></Border></Grid>
          <TextBlock Grid.Row="1" Text="{Binding RuleContext}" Classes="caption" Margin="0,12,0,2"/>
          <TextBlock Grid.Row="2" Text="{Binding RuleLabel}" Classes="heading" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Row="3" Spacing="3" Margin="0,14,0,0">
            <TextBlock Text="Próxima transição" Classes="caption"/>
            <TextBlock Text="{Binding NextAction}" Classes="accent" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ExpectedEnd}" Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Row="5" Content="Ver programação semanal" Command="{Binding NavigateCommand}" CommandParameter="Programação" HorizontalAlignment="Left" Margin="0,16,0,0"/>
        </Grid>
      </Border>
    </Grid>

    <UniformGrid Columns="3" ColumnSpacing="18">
      <Button Classes="tile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding NavigateCommand}" CommandParameter="Biblioteca" AutomationProperties.Name="Abrir biblioteca">
        <Border Classes="card" Padding="16"><Grid ColumnDefinitions="40,*"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top"><Path Classes="icon accentIcon" Data="{StaticResource LibraryIcon}" Width="15" Height="15"/></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding LibraryTotalLabel}" Classes="subheading" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding LibraryHealth}" Classes="caption" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
      </Button>
      <Button Classes="tile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding NavigateCommand}" CommandParameter="Playlists" AutomationProperties.Name="Abrir playlists">
        <Border Classes="card" Padding="16"><Grid ColumnDefinitions="40,*"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top"><Path Classes="icon accentIcon" Data="{StaticResource PlaylistIcon}" Width="15" Height="15"/></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding PlaylistTotalLabel}" Classes="subheading" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Repertórios salvos localmente" Classes="caption" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
      </Button>
      <Button Classes="tile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding NavigateCommand}" CommandParameter="Fila" AutomationProperties.Name="Abrir fila de reprodução">
        <Border Classes="card" Padding="16"><Grid ColumnDefinitions="40,*"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top"><Path Classes="icon accentIcon" Data="{StaticResource QueueIcon}" Width="15" Height="15"/></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding QueueCountLabel, StringFormat='Fila: {0}'}" Classes="subheading" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding QueueOriginLabel}" Classes="caption" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
      </Button>
    </UniformGrid>

    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Suas playlists" Classes="heading"/><Button Grid.Column="1" Classes="link" Content="Ver todas" Command="{Binding NavigateCommand}" CommandParameter="Playlists"/></Grid>
      <TextBlock Text="Nenhuma playlist salva. Crie uma em Playlists ou importe uma pelo link." IsVisible="{Binding HasNoPlaylists}" Classes="muted" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Playlists}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="176"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Button Classes="ghost" Padding="8" Margin="0,0,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding $parent[UserControl].DataContext.OpenPlaylistCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="Abrir playlist (não inicia reprodução)">
            <StackPanel Spacing="8">
              <Border Classes="cover" Height="120"><Grid><TextBlock Text="{Binding Name, Converter={x:Static controls:TextConverters.Initial}}" FontSize="44" FontWeight="Bold" Classes="accent" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
              <StackPanel Spacing="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="Playlist padrão" IsVisible="{Binding IsDefault}" Classes="caption accent"/><TextBlock Text="Playlist local" IsVisible="{Binding !IsDefault}" Classes="caption"/></StackPanel>
            </StackPanel>
          </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border Classes="card" Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Path Classes="icon" Data="{StaticResource HistoryIcon}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="HISTÓRICO OPERACIONAL" Classes="eyebrow"/><TextBlock Text="{Binding HistoryDashboard}" Classes="caption" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Button Grid.Column="2" Classes="ghost" Content="Abrir Histórico" Command="{Binding NavigateCommand}" CommandParameter="Histórico" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </StackPanel></ScrollViewer>
</UserControl>
