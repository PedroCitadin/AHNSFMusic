<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AHNSF.Music.Desktop" x:Class="AHNSF.Music.Desktop.Views.HistoryView" x:DataType="local:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <!-- Filters -->
    <Border Classes="card" Padding="16"><StackPanel Spacing="10">
      <WrapPanel>
        <StackPanel Spacing="4" Margin="0,0,10,6"><TextBlock Text="Período" Classes="caption"/><ComboBox ItemsSource="{Binding HistoryPeriods}" SelectedIndex="{Binding HistoryPeriodIndex}" Width="200" AutomationProperties.Name="Período do histórico"/></StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,6"><TextBlock Text="Tipo" Classes="caption"/><ComboBox ItemsSource="{Binding HistoryTypes}" SelectedItem="{Binding HistoryType}" Width="230" AutomationProperties.Name="Tipo de evento"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,6"><TextBlock Text="Severidade" Classes="caption"/><ComboBox ItemsSource="{Binding HistorySeverities}" SelectedItem="{Binding HistorySeverity}" Width="200" AutomationProperties.Name="Severidade"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,6"><TextBlock Text="Pesquisa" Classes="caption"/><TextBox Text="{Binding HistorySearch}" Watermark="Descrição ou componente" Width="260" AutomationProperties.Name="Pesquisar histórico"/></StackPanel>
      </WrapPanel>
      <WrapPanel IsVisible="{Binding HistoryCustomPeriod}"><TextBox Text="{Binding HistoryFrom}" Watermark="Início AAAA-MM-DD" Width="180" Margin="0,0,8,6" AutomationProperties.Name="Data inicial"/><TextBox Text="{Binding HistoryUntil}" Watermark="Fim AAAA-MM-DD" Width="180" Margin="0,0,8,6" AutomationProperties.Name="Data final"/><TextBlock Text="Datas locais; início e fim incluídos." Classes="caption" VerticalAlignment="Center"/></WrapPanel>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Aplicar filtros / atualizar" Command="{Binding RefreshHistoryCommand}" Classes="accent"/><Button Content="Exportar CSV…" Command="{Binding ExportHistoryCommand}" IsEnabled="{Binding !HistoryExporting}"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTip.Tip="Limpeza automática incremental. Logs técnicos separados.">
          <TextBlock Text="Retenção" Classes="caption" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding HistoryRetentionOptions}" SelectedItem="{Binding HistoryRetentionDays}" Width="90" AutomationProperties.Name="Retenção em dias"/><TextBlock Text="dias" Classes="caption" VerticalAlignment="Center"/><Button Content="Salvar retenção" Classes="ghost" Command="{Binding SaveHistoryRetentionCommand}"/>
        </StackPanel>
      </Grid>
    </StackPanel></Border>
    <StackPanel Grid.Row="1" Spacing="4"><ProgressBar IsIndeterminate="True" IsVisible="{Binding HistoryLoading}" Height="3" MinHeight="3"/><TextBlock Text="{Binding HistoryFeedback}" TextWrapping="Wrap" Classes="caption"/></StackPanel>
    <TabControl Grid.Row="2" Padding="0,8,0,0">
      <TabItem Header="Eventos"><Grid RowDefinitions="*,Auto,Auto">
        <Border Classes="list"><Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="130,220,*" Margin="13,8,10,8"><TextBlock Text="QUANDO" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="TIPO / ORIGEM" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="DESCRIÇÃO" Classes="eyebrow"/></Grid>
          <Border Grid.Row="1" Classes="divider" Margin="8,0,8,4"/>
          <ListBox Grid.Row="2" ItemsSource="{Binding HistoryEvents}" SelectedItem="{Binding SelectedHistoryEvent}" AutomationProperties.Name="Eventos operacionais"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="130,220,*" Margin="0,3"><StackPanel Spacing="1"><TextBlock Text="{Binding Time}" FontWeight="SemiBold"/><TextBlock Text="{Binding Severity}" Classes="caption"/></StackPanel><StackPanel Grid.Column="1" Spacing="1" Margin="0,0,12,0"><TextBlock Text="{Binding Type}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Origin}" Classes="caption" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Grid.Row="2" Text="Nenhum evento encontrado neste período e filtros." IsVisible="{Binding HistoryEmpty}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid></Border>
        <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,10,0,0"><StackPanel Spacing="4"><TextBlock Text="DETALHES DO EVENTO SELECIONADO" Classes="eyebrow"/><ScrollViewer MaxHeight="130"><TextBlock Text="{Binding HistoryEventDetails}" TextWrapping="Wrap" FontSize="12"/></ScrollViewer></StackPanel></Border>
      </Grid></TabItem>
      <TabItem Header="Reprodução"><Border Classes="list"><ListBox ItemsSource="{Binding HistoryPlayback}" AutomationProperties.Name="Períodos de reprodução"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4" Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="caption"/><TextBlock Text="{Binding Timing}" FontSize="12"/><TextBlock Text="{Binding Duration}" Classes="caption" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></TabItem>
      <TabItem Header="Sessões do aplicativo"><Grid RowDefinitions="Auto,*"><TextBlock Text="Execuções recentes (50 por página); os filtros de eventos não alteram esta lista." Classes="caption" Margin="4,0,0,8"/><Border Grid.Row="1" Classes="list"><ListBox ItemsSource="{Binding HistorySessions}" AutomationProperties.Name="Sessões operacionais"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4" Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></TabItem>
    </TabControl>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding HistoryPagination}" Classes="caption" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="‹ Página anterior" Classes="ghost" Command="{Binding PreviousHistoryPageCommand}" IsEnabled="{Binding HistoryHasPrevious}"/><Button Content="Próxima página ›" Classes="ghost" Command="{Binding NextHistoryPageCommand}" IsEnabled="{Binding HistoryHasNext}"/></StackPanel></Grid>
  </Grid>
</UserControl>
