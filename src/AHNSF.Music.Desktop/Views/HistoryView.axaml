<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AHNSF.Music.Desktop" x:Class="AHNSF.Music.Desktop.Views.HistoryView" x:DataType="local:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    <Border Classes="card"><StackPanel Spacing="8">
      <WrapPanel><ComboBox ItemsSource="{Binding HistoryPeriods}" SelectedIndex="{Binding HistoryPeriodIndex}" Width="210" Margin="0,0,8,8" AutomationProperties.Name="Período do histórico"/><ComboBox ItemsSource="{Binding HistoryTypes}" SelectedItem="{Binding HistoryType}" Width="240" Margin="0,0,8,8" AutomationProperties.Name="Tipo de evento"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox ItemsSource="{Binding HistorySeverities}" SelectedItem="{Binding HistorySeverity}" Width="210" Margin="0,0,8,8" AutomationProperties.Name="Severidade"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></WrapPanel>
      <WrapPanel IsVisible="{Binding HistoryCustomPeriod}"><TextBox Text="{Binding HistoryFrom}" Watermark="Início AAAA-MM-DD" Width="180" Margin="0,0,8,8" AutomationProperties.Name="Data inicial"/><TextBox Text="{Binding HistoryUntil}" Watermark="Fim AAAA-MM-DD" Width="180" Margin="0,0,8,8" AutomationProperties.Name="Data final"/><TextBlock Text="Datas locais; início e fim incluídos." Classes="muted" VerticalAlignment="Center"/></WrapPanel>
      <WrapPanel><TextBox Text="{Binding HistorySearch}" Watermark="Pesquisar descrição ou componente" Width="320" Margin="0,0,8,8" AutomationProperties.Name="Pesquisar histórico"/><Button Content="Aplicar filtros / atualizar" Command="{Binding RefreshHistoryCommand}" Classes="accent" Margin="0,0,8,8"/><Button Content="Exportar CSV…" Command="{Binding ExportHistoryCommand}" IsEnabled="{Binding !HistoryExporting}" Margin="0,0,0,8"/></WrapPanel>
      <WrapPanel><TextBlock Text="Retenção (dias)" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding HistoryRetentionOptions}" SelectedItem="{Binding HistoryRetentionDays}" Width="90" Margin="0,0,8,0"/><Button Content="Salvar retenção" Command="{Binding SaveHistoryRetentionCommand}"/><TextBlock Text="Limpeza automática incremental. Logs técnicos separados." Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
    </StackPanel></Border>
    <StackPanel Grid.Row="1" Spacing="4"><ProgressBar IsIndeterminate="True" IsVisible="{Binding HistoryLoading}" Height="3"/><TextBlock Text="{Binding HistoryFeedback}" TextWrapping="Wrap" Classes="muted"/></StackPanel>
    <TabControl Grid.Row="2">
      <TabItem Header="Eventos"><Grid RowDefinitions="*,Auto,Auto">
        <ListBox ItemsSource="{Binding HistoryEvents}" SelectedItem="{Binding SelectedHistoryEvent}" AutomationProperties.Name="Eventos operacionais"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="120,220,*" Margin="6,8"><StackPanel><TextBlock Text="{Binding Time}"/><TextBlock Text="{Binding Severity}" Classes="muted"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Type}"/><TextBlock Text="{Binding Origin}" Classes="muted"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock Grid.Row="1" Text="Nenhum evento encontrado neste período e filtros." IsVisible="{Binding HistoryEmpty}" Margin="8" Classes="muted"/>
        <Border Grid.Row="2" Classes="card" Margin="0,8,0,0"><ScrollViewer MaxHeight="150"><TextBlock Text="{Binding HistoryEventDetails}" TextWrapping="Wrap" FontSize="12"/></ScrollViewer></Border>
      </Grid></TabItem>
      <TabItem Header="Reprodução"><ListBox ItemsSource="{Binding HistoryPlayback}" AutomationProperties.Name="Períodos de reprodução"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8" Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="muted"/><TextBlock Text="{Binding Timing}"/><TextBlock Text="{Binding Duration}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
      <TabItem Header="Sessões do aplicativo"><Grid RowDefinitions="Auto,*"><TextBlock Text="Execuções recentes (50 por página); os filtros de eventos não alteram esta lista." Classes="muted" Margin="8"/><ListBox Grid.Row="1" ItemsSource="{Binding HistorySessions}" AutomationProperties.Name="Sessões operacionais"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8" Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
    </TabControl>
    <WrapPanel Grid.Row="3"><Button Content="Página anterior" Command="{Binding PreviousHistoryPageCommand}" IsEnabled="{Binding HistoryHasPrevious}" Margin="0,0,8,0"/><Button Content="Próxima página" Command="{Binding NextHistoryPageCommand}" IsEnabled="{Binding HistoryHasNext}" Margin="0,0,12,0"/><TextBlock Text="{Binding HistoryPagination}" VerticalAlignment="Center"/></WrapPanel>
  </Grid>
</UserControl>
