<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AHNSF.Music.Desktop.Controls" x:Class="AHNSF.Music.Desktop.Views.ScheduleView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18" Margin="0,0,14,8">
    <!-- Mode and current rule -->
    <Border Classes="hero" Padding="20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ScheduleSummary}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="{Binding ScheduleNext}" Classes="accent" TextWrapping="Wrap"/>
          <TextBlock Text="Horários locais do Windows. Os dias indicam o início da janela. Intervenções no player suspendem o Automático até a próxima mudança da vencedora." Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"><Button Content="Modo Manual" Command="{Binding ManualModeCommand}"/><Button Content="Ativar Automático" Classes="accent" Command="{Binding AutomaticModeCommand}"/></StackPanel>
          <Button Content="Suspender automação" Classes="ghost" Command="{Binding SuspendAutomationCommand}" HorizontalAlignment="Right" ToolTip.Tip="Suspende até a próxima mudança da regra vencedora"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Classes="card alert" Padding="14,10" IsVisible="{Binding ScheduleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><Grid ColumnDefinitions="28,*"><Path Classes="icon warningIcon" Data="{StaticResource AlertIcon}" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding ScheduleWarning}" Classes="warning" TextWrapping="Wrap"/></Grid></Border>

    <!-- Weekly timeline -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Quando o som estará ligado" Classes="heading"/>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource AccentPrimaryBrush}"/><TextBlock Text="Vigente" Classes="caption"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Border Width="12" Height="12" CornerRadius="3" Classes="block"/><TextBlock Text="Programado" Classes="caption"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"><Border Width="12" Height="12" CornerRadius="3" Classes="block conflict"/><TextBlock Text="Sobreposição" Classes="caption"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="12" Height="12" CornerRadius="3" Classes="block disabled"/><TextBlock Text="Desativada" Classes="caption"/></StackPanel>
          </WrapPanel>
        </Grid>
        <Grid ColumnDefinitions="92,*">
          <Grid Grid.Column="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,2">
            <TextBlock Text="00h" Classes="caption" FontSize="11"/><TextBlock Grid.Column="1" Text="06h" Classes="caption" FontSize="11"/><TextBlock Grid.Column="2" Text="12h" Classes="caption" FontSize="11"/><TextBlock Grid.Column="3" Text="18h" Classes="caption" FontSize="11"/>
            <TextBlock Grid.Column="3" Text="24h" Classes="caption" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
        </Grid>
        <ItemsControl ItemsSource="{Binding WeeklyDays}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid ColumnDefinitions="92,*" Height="34" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding Summary}"><TextBlock Text="{Binding ShortName}" FontWeight="SemiBold"/><Border Classes="badge accent" IsVisible="{Binding IsToday}" Padding="6,1"><TextBlock Text="HOJE" FontSize="10"/></Border></StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource BackgroundPrimaryBrush}" CornerRadius="6">
                <Grid>
                  <Grid ColumnDefinitions="*,*,*,*" IsHitTestVisible="False"><Border Grid.Column="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0"/><Border Grid.Column="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0"/><Border Grid.Column="3" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0"/></Grid>
                  <ItemsControl Classes="timeline" ItemsSource="{Binding Blocks}" Margin="1,3">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:TimelinePanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border Classes="block" Classes.winner="{Binding IsWinner}" Classes.conflict="{Binding HasConflict}" Classes.disabled="{Binding IsDisabled}" ToolTip.Tip="{Binding Tip}"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Faixas vazias: sem programação (no Automático, o player permanece parado). Passe o mouse sobre um bloco para ver playlist, volume e prioridade." Classes="caption" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Rules -->
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Regras cadastradas" Classes="heading" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="accent" Command="{Binding NewRuleCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="icon" Data="{StaticResource PlusIcon}" Width="12" Height="12"/><TextBlock Text="Nova regra"/></StackPanel></Button></Grid>
    <TextBlock Text="Nenhuma regra cadastrada. Crie uma regra e ative o modo Automático quando estiver pronto." IsVisible="{Binding HasNoRules}" Classes="muted" TextWrapping="Wrap"/>
    <Border Classes="list" IsVisible="{Binding !HasNoRules}">
      <ListBox ItemsSource="{Binding ScheduleCards}" SelectedItem="{Binding SelectedScheduleCard, Mode=TwoWay}" MaxHeight="260" AutomationProperties.Name="Regras de programação"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="0,4">
          <StackPanel Spacing="2"><TextBlock Text="{Binding Rule.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Classes="caption" TextTrimming="CharacterEllipsis"><Run Text="{Binding Playlist}"/><Run Text=" • "/><Run Text="{Binding Days}"/><Run Text=" • "/><Run Text="{Binding Details}"/></TextBlock></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Hours}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding Color, Converter={StaticResource ToneBrush}}" FontSize="12" VerticalAlignment="Center" MinWidth="130"/>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate></ListBox>
    </Border>
    <WrapPanel IsVisible="{Binding !HasNoRules}"><Button Content="Editar regra" Command="{Binding EditRuleCommand}" Margin="0,0,8,6"/><Button Content="Habilitar / desativar" Command="{Binding ToggleRuleCommand}" Margin="0,0,8,6"/><Button Content="Excluir regra" Classes="ghost danger" Command="{Binding RequestDeleteRuleCommand}" Margin="0,0,0,6"/></WrapPanel>
    <Border Classes="card" IsVisible="{Binding ScheduleEditor}"><StackPanel Spacing="10" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Editar programação" Classes="heading"/><TextBlock Text="Nome da regra" Classes="caption"/><TextBox Text="{Binding RuleName, Mode=TwoWay}" Watermark="Nome obrigatório" MaxLength="200" AutomationProperties.Name="Nome da regra"/><TextBlock Text="Playlist" Classes="caption"/><ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding RulePlaylist, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Escolha a playlist" AutomationProperties.Name="Playlist da regra"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Dias" Classes="caption"/><ItemsControl ItemsSource="{Binding RuleDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,0,6,6" MinWidth="52"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel Spacing="5"><TextBlock Text="Início (HH:mm)" Classes="caption"/><TextBox Text="{Binding RuleStart, Mode=TwoWay}" ToolTip.Tip="Exemplo: 08:30" AutomationProperties.Name="Início"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Fim (HH:mm)" Classes="caption"/><TextBox Text="{Binding RuleEnd, Mode=TwoWay}" ToolTip.Tip="Um fim anterior ao início atravessa a meia-noite" AutomationProperties.Name="Fim"/></StackPanel><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Prioridade (0–1000)" Classes="caption"/><TextBox Text="{Binding RulePriority, Mode=TwoWay}" ToolTip.Tip="A maior prioridade vence sobreposições" AutomationProperties.Name="Prioridade"/></StackPanel></Grid><TextBlock Text="{Binding RuleVolume, StringFormat='Volume da regra: {0:0}%'}"/><Slider Minimum="0" Maximum="100" Value="{Binding RuleVolume, Mode=TwoWay}" AutomationProperties.Name="Volume da regra"/><CheckBox Content="Regra habilitada" IsChecked="{Binding RuleEnabled, Mode=TwoWay}"/><WrapPanel><Button Content="Salvar regra" Classes="accent" Command="{Binding SaveRuleCommand}" Margin="0,0,8,4"/><Button Content="Cancelar edição" Command="{Binding CancelRuleEditCommand}" Margin="0,0,0,4"/></WrapPanel></StackPanel></Border>
    <Border Classes="card danger" IsVisible="{Binding ScheduleDeleteConfirmation}"><StackPanel Spacing="8"><TextBlock Text="{Binding RuleDeletePrompt}" TextWrapping="Wrap"/><WrapPanel><Button Content="Confirmar exclusão da regra" Classes="danger" Command="{Binding ConfirmDeleteRuleCommand}" Margin="0,0,8,4"/><Button Content="Cancelar exclusão" Command="{Binding CancelDeleteRuleCommand}" Margin="0,0,0,4"/></WrapPanel></StackPanel></Border>

    <!-- Text details per day (screen readers, overlap details, gaps) -->
    <Expander Header="Detalhes por dia (lista textual, incluindo lacunas)" HorizontalAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding WeeklyDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="340"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,12,12" Padding="14" VerticalAlignment="Stretch"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" Classes="subheading"/><TextBlock Text="{Binding Summary}" Classes="caption" FontSize="11"/></StackPanel><Border Grid.Column="1" Classes="badge accent" IsVisible="{Binding IsToday}" VerticalAlignment="Top"><TextBlock Text="HOJE"/></Border></Grid><ItemsControl ItemsSource="{Binding Intervals}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,0,0,8"><Grid ColumnDefinitions="104,*"><TextBlock Text="{Binding Hours}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Color, Converter={StaticResource ToneBrush}}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding Color, Converter={StaticResource ToneBrush}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Classes="caption" TextWrapping="Wrap"/><WrapPanel><TextBlock Text="{Binding State}" Foreground="{Binding Color, Converter={StaticResource ToneBrush}}" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="⚠ Sobreposição de horários" IsVisible="{Binding HasConflict}" Classes="warning" FontSize="11"/></WrapPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Expander>
  </StackPanel></ScrollViewer>
</UserControl>
