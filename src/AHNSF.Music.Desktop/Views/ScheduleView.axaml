<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AHNSF.Music.Desktop.Views.ScheduleView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" Margin="0,0,14,0">
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding ScheduleSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ScheduleNext}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/><WrapPanel><Button Content="Modo Manual" Command="{Binding ManualModeCommand}" Margin="0,0,8,6"/><Button Content="Ativar Automático" Classes="accent" Command="{Binding AutomaticModeCommand}" Margin="0,0,8,6"/><Button Content="Suspender automação" Command="{Binding SuspendAutomationCommand}" Margin="0,0,0,6"/></WrapPanel><TextBlock Text="Horários locais do Windows. Os dias indicam o início da janela. Intervenções no player suspendem o Automático até a próxima mudança da vencedora." Classes="muted" TextWrapping="Wrap" FontSize="12"/></StackPanel></Border>
    <Border Classes="card alert" Padding="14,10" IsVisible="{Binding ScheduleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><Grid ColumnDefinitions="26,*"><Path Classes="icon" Data="{StaticResource AlertIcon}" Stroke="{StaticResource WarningBrush}" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding ScheduleWarning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/></Grid></Border>
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Regras cadastradas" Classes="heading" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Nova regra" Classes="accent" Command="{Binding NewRuleCommand}"/></Grid>
    <TextBlock Text="Nenhuma regra cadastrada. Crie uma regra e ative o modo Automático quando estiver pronto." IsVisible="{Binding HasNoRules}" Classes="muted" TextWrapping="Wrap"/>
    <ListBox ItemsSource="{Binding ScheduleCards}" SelectedItem="{Binding SelectedScheduleCard, Mode=TwoWay}" MaxHeight="240"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Rule.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Playlist}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding Days}" Classes="muted" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Classes="muted" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0"><TextBlock Text="{Binding Hours}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" Foreground="{Binding Color}" FontSize="12"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <WrapPanel IsVisible="{Binding !HasNoRules}"><Button Content="Editar regra" Command="{Binding EditRuleCommand}" Margin="0,0,8,6"/><Button Content="Habilitar / desativar" Command="{Binding ToggleRuleCommand}" Margin="0,0,8,6"/><Button Content="Excluir regra" Classes="danger" Command="{Binding RequestDeleteRuleCommand}" Margin="0,0,0,6"/></WrapPanel>
    <Border Classes="card" IsVisible="{Binding ScheduleEditor}"><StackPanel Spacing="10"><TextBlock Text="Editar programação" Classes="heading"/><TextBlock Text="Nome da regra" Classes="eyebrow"/><TextBox Text="{Binding RuleName, Mode=TwoWay}" Watermark="Nome obrigatório" MaxLength="200"/><TextBlock Text="Playlist" Classes="eyebrow"/><ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding RulePlaylist, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Escolha a playlist"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ItemsControl ItemsSource="{Binding RuleDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,0,12,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid ColumnDefinitions="*,*,*"><StackPanel Margin="0,0,8,0" Spacing="5"><TextBlock Text="Início (HH:mm)" Classes="eyebrow"/><TextBox Text="{Binding RuleStart, Mode=TwoWay}" ToolTip.Tip="Exemplo: 08:30"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0" Spacing="5"><TextBlock Text="Fim (HH:mm)" Classes="eyebrow"/><TextBox Text="{Binding RuleEnd, Mode=TwoWay}" ToolTip.Tip="Um fim anterior ao início atravessa a meia-noite"/></StackPanel><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Prioridade (0–1000)" Classes="eyebrow"/><TextBox Text="{Binding RulePriority, Mode=TwoWay}" ToolTip.Tip="A maior prioridade vence sobreposições"/></StackPanel></Grid><TextBlock Text="{Binding RuleVolume, StringFormat='Volume da regra: {0:0}%'}"/><Slider Minimum="0" Maximum="100" Value="{Binding RuleVolume, Mode=TwoWay}"/><CheckBox Content="Regra habilitada" IsChecked="{Binding RuleEnabled, Mode=TwoWay}"/><WrapPanel><Button Content="Salvar regra" Classes="accent" Command="{Binding SaveRuleCommand}" Margin="0,0,8,4"/><Button Content="Cancelar edição" Command="{Binding CancelRuleEditCommand}" Margin="0,0,0,4"/></WrapPanel></StackPanel></Border>
    <Border Classes="card danger" IsVisible="{Binding ScheduleDeleteConfirmation}"><StackPanel Spacing="8"><TextBlock Text="{Binding RuleDeletePrompt}" TextWrapping="Wrap"/><WrapPanel><Button Content="Confirmar exclusão da regra" Classes="danger" Command="{Binding ConfirmDeleteRuleCommand}" Margin="0,0,8,4"/><Button Content="Cancelar exclusão" Command="{Binding CancelDeleteRuleCommand}" Margin="0,0,0,4"/></WrapPanel></StackPanel></Border>
    <TextBlock Text="Quando o som estará ligado" Classes="heading"/><TextBlock Text="▶ Vigente   ◷ Futuro   ⚠ Sobreposição   ○ Desativada   — Sem programação" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding WeeklyDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="340"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,12,12" Padding="14" VerticalAlignment="Stretch"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" Classes="heading"/><TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="HOJE" IsVisible="{Binding IsToday}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Grid><ItemsControl ItemsSource="{Binding Intervals}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,10"><Grid ColumnDefinitions="112,*"><TextBlock Text="{Binding Hours}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Color}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding Color}" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap"/><WrapPanel><TextBlock Text="{Binding State}" Foreground="{Binding Color}" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="⚠ Sobreposição de horários" IsVisible="{Binding HasConflict}" Foreground="{StaticResource WarningBrush}" FontSize="11"/></WrapPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
