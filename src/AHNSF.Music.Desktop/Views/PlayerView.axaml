<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AHNSF.Music.Desktop.Controls" x:Class="AHNSF.Music.Desktop.Views.PlayerView">
  <!-- Fixed player: left = now playing, centre = transport + progress, right = shuffle/repeat/volume/output. -->
  <Border Classes="player" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="3*,4*,3*" VerticalAlignment="Center">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,16,0">
        <controls:ArtworkView CacheKey="{Binding CurrentTrack.ArtworkCacheKey}" Width="56" Height="56" CornerRadius="8" Margin="0,0,14,0"/>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentTitle}"/>
          <TextBlock Text="{Binding CurrentArtist}" Classes="caption" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding QueueOrigin}" Classes="caption accent" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="Origem da fila atual"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto" MaxWidth="640" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Classes="round ghost" Command="{Binding StopCommand}" ToolTip.Tip="Parar reprodução" AutomationProperties.Name="Parar"><Path Classes="icon" Data="{StaticResource StopIcon}" Width="14" Height="14"/></Button>
          <Button Classes="round ghost" Command="{Binding PreviousCommand}" ToolTip.Tip="Música anterior" AutomationProperties.Name="Anterior"><Path Classes="icon" Data="{StaticResource PreviousIcon}" Width="16" Height="16"/></Button>
          <Button Classes="round play accent" Command="{Binding PlayPauseCommand}" ToolTip.Tip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}">
            <Grid><Path Classes="icon filled" Data="{StaticResource PlayIcon}" IsVisible="{Binding !IsPlaying}" Width="16" Height="16" Margin="3,0,0,0"/><Path Classes="icon" Data="{StaticResource PauseIcon}" IsVisible="{Binding IsPlaying}" StrokeThickness="3" Width="16" Height="16"/></Grid>
          </Button>
          <Button Classes="round ghost" Command="{Binding NextCommand}" ToolTip.Tip="Próxima música" AutomationProperties.Name="Próxima"><Path Classes="icon" Data="{StaticResource NextIcon}" Width="16" Height="16"/></Button>
          <Border Width="36"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="44,*,44" Margin="0,2,0,0">
          <TextBlock Text="{Binding PositionText}" Classes="caption" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="{Binding Duration}" IsEnabled="{Binding CanSeek}" Value="{Binding Position, Mode=TwoWay}" AutomationProperties.Name="Progresso da música" Margin="10,-10"/>
          <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="caption" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="360">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <ToggleButton Grid.Column="1" Classes="round ghost" IsChecked="{Binding ShuffleEnabled, Mode=TwoWay}" Width="30" Height="30" Margin="0,0,6,0" ToolTip.Tip="Aleatório: embaralha as próximas ocorrências sem mudar a ordem salva" AutomationProperties.Name="Aleatório"><Path Classes="icon" Data="{StaticResource ShuffleIcon}" Width="15" Height="15"/></ToggleButton>
          <StackPanel Orientation="Horizontal" Spacing="6" Classes="wideOnly" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="{Binding AudioDeviceMessage}">
            <Path Classes="icon" Data="{StaticResource SpeakerIcon}" Width="14" Height="14" Classes.warningIcon="{Binding AudioDeviceNeedsAttention}"/>
            <TextBlock Text="{Binding AudioDeviceEffective}" Classes="caption" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150" Classes.warning="{Binding AudioDeviceNeedsAttention}" VerticalAlignment="Center"/>
          </StackPanel>
          <ComboBox Grid.Column="2" ItemsSource="{Binding RepeatOptions}" SelectedIndex="{Binding RepeatIndex, Mode=TwoWay}" Width="164" MinHeight="30" FontSize="12" ToolTip.Tip="Preferência de repetição manual; sessões agendadas repetem a fila" AutomationProperties.Name="Modo de repetição"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,40" Margin="0,4,0,0">
          <Path Classes="icon" Data="{StaticResource VolumeIcon}" Width="16" Height="16" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" MinWidth="110" AutomationProperties.Name="Volume" ToolTip.Tip="Volume manual; regras automáticas aplicam o próprio volume" Margin="10,-10"/>
          <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat='{}{0:0}%'}" Classes="caption" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
