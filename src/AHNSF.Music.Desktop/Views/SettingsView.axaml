<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AHNSF.Music.Desktop.Views.SettingsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,14,0">
    <Border Classes="card"><StackPanel Spacing="10">
      <TextBlock Text="Pasta musical" Classes="heading"/>
      <TextBlock Text="{Binding MusicDirectory}" TextWrapping="Wrap" Classes="muted"/>
      <TextBlock Text="{Binding LibraryHealth}" FontSize="12"/>
      <WrapPanel><Button Content="Selecionar pasta" Classes="accent" Command="{Binding ChooseDirectoryCommand}" Margin="0,0,8,4"/><Button Content="Atualizar biblioteca" Command="{Binding RefreshCommand}" Margin="0,0,8,4" ToolTip.Tip="Reconciliar a pasta agora"/><Button Content="Reindexar todos os metadados" Command="{Binding ForceReindexCommand}" Margin="0,0,0,4" ToolTip.Tip="Reler também arquivos cujo tamanho e data não mudaram"/></WrapPanel>
      <TextBlock Text="As músicas originais são apenas lidas. Nenhum arquivo é alterado." TextWrapping="Wrap" Classes="muted" FontSize="12"/>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="8">
      <TextBlock Text="Reprodução" Classes="heading"/>
      <TextBlock Text="{Binding VolumeLabel}"/>
      <TextBlock Text="O volume, Aleatório e Repetir são salvos automaticamente. A reprodução usa a saída de áudio padrão do Windows." TextWrapping="Wrap" Classes="muted" FontSize="12"/>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="8">
      <TextBlock Text="Atalhos de teclado" Classes="heading"/>
      <TextBlock Text="Ctrl+1 a Ctrl+6: Início, Biblioteca, Playlists, Fila, Programação e Configurações" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Text="Ctrl+F: pesquisar na biblioteca  •  Esc: cancelar confirmação aberta  •  Tab: percorrer controles" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Text="Dados locais e registros: %LOCALAPPDATA%\AHNSF Music" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
