<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AHNSF.Music.Desktop" xmlns:controls="using:AHNSF.Music.Desktop.Controls" xmlns:views="using:AHNSF.Music.Desktop.Views" x:Class="AHNSF.Music.Desktop.MainWindow" Title="AHNSF Music" Width="1100" Height="760" MinWidth="900" MinHeight="620">
  <Window.KeyBindings><KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="Início"/><KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="Biblioteca"/><KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="Playlists"/><KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="Fila"/><KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="Programação"/><KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="Configurações"/></Window.KeyBindings>
  <Window.Resources><local:CurrentTrackConverter x:Key="CurrentTrackConverter"/></Window.Resources>
  <Grid RowDefinitions="*,Auto"><Grid ColumnDefinitions="174,*">
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,24,14,16"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Margin="8,0,0,28" Spacing="4"><TextBlock Text="AHNSF" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="MUSIC" FontSize="12" FontWeight="SemiBold" Classes="muted"/></StackPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6"><TextBlock Text="NAVEGAÇÃO" Classes="eyebrow" Margin="12,0,0,8"/><Button Classes="nav" Classes.active="{Binding ShowHome}" Command="{Binding NavigateCommand}" CommandParameter="Início" AutomationProperties.Name="Início" ToolTip.Tip="Início"><Grid ColumnDefinitions="32,*,Auto"><Path Classes="icon" Data="{StaticResource HomeIcon}"/><TextBlock Grid.Column="1" Text="Início" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="•" IsVisible="{Binding ShowHome}"/></Grid></Button><Button Classes="nav" Classes.active="{Binding IsLibrarySection}" Command="{Binding NavigateCommand}" CommandParameter="Biblioteca" AutomationProperties.Name="Biblioteca" ToolTip.Tip="Biblioteca"><Grid ColumnDefinitions="32,*,Auto"><Path Classes="icon" Data="{StaticResource LibraryIcon}"/><TextBlock Grid.Column="1" Text="Biblioteca" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="•" IsVisible="{Binding IsLibrarySection}"/></Grid></Button><Button Classes="nav" Classes.active="{Binding IsPlaylistSection}" Command="{Binding NavigateCommand}" CommandParameter="Playlists" AutomationProperties.Name="Playlists" ToolTip.Tip="Playlists"><Grid ColumnDefinitions="32,*,Auto"><Path Classes="icon" Data="{StaticResource PlaylistIcon}"/><TextBlock Grid.Column="1" Text="Playlists" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="•" IsVisible="{Binding IsPlaylistSection}"/></Grid></Button><Button Classes="nav" Classes.active="{Binding IsQueueSection}" Command="{Binding NavigateCommand}" CommandParameter="Fila" AutomationProperties.Name="Fila" ToolTip.Tip="Fila"><Grid ColumnDefinitions="32,*,Auto"><Path Classes="icon" Data="{StaticResource QueueIcon}"/><TextBlock Grid.Column="1" Text="Fila" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="•" IsVisible="{Binding IsQueueSection}"/></Grid></Button><Button Classes="nav" Classes.active="{Binding IsScheduleSection}" Command="{Binding NavigateCommand}" CommandParameter="Programação" AutomationProperties.Name="Programação" ToolTip.Tip="Programação"><Grid ColumnDefinitions="32,*,Auto"><Path Classes="icon" Data="{StaticResource CalendarIcon}"/><TextBlock Grid.Column="1" Text="Programação" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="•" IsVisible="{Binding IsScheduleSection}"/></Grid></Button><Button Classes="nav" Classes.active="{Binding IsSettingsSection}" Command="{Binding NavigateCommand}" CommandParameter="Configurações" AutomationProperties.Name="Configurações" ToolTip.Tip="Configurações"><Grid ColumnDefinitions="32,*,Auto"><Path Classes="icon" Data="{StaticResource SettingsIcon}"/><TextBlock Grid.Column="1" Text="Configurações" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="•" IsVisible="{Binding IsSettingsSection}"/></Grid></Button></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Spacing="5" Margin="8,20,0,0"><TextBlock Text="● Operação local" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="Música ambiente hospitalar" Classes="muted" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="Fase 0.5" Classes="muted" FontSize="10"/></StackPanel></Grid></Border>
    <Border Grid.Column="1" Classes="page" Padding="24,20,24,12"><Grid RowDefinitions="Auto,*,Auto"><Grid Classes="pageHeader" ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{Binding PageTitle}" Classes="title"/><TextBlock Text="{Binding PageDescription}" Classes="muted pageDescription" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Background="{StaticResource RaisedBrush}" CornerRadius="7" Padding="12,6" VerticalAlignment="Top" Margin="12,3,0,0" ToolTip.Tip="Modo de operação. Altere em Programação."><StackPanel Spacing="1"><TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding AutomationLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Right"/></StackPanel></Border></Grid>
      <Grid Grid.Row="1">
        <views:HomeView IsVisible="{Binding ShowHome}"/>
        <views:LibraryView x:Name="LibraryPage" IsVisible="{Binding ShowLibrary}"/>
        <views:PlaylistsView x:Name="PlaylistsPage" IsVisible="{Binding ShowPlaylists}"/>
        <views:QueueView x:Name="QueuePage" IsVisible="{Binding ShowQueue}"/>
        <views:ScheduleView IsVisible="{Binding ShowSchedule}"/>
        <views:SettingsView IsVisible="{Binding ShowSettings}"/>
      </Grid>
      <StackPanel Grid.Row="2" Classes="pageFooter" Spacing="4"><ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3"/><TextBlock Text="{Binding LibraryStatus}" Classes="muted" TextWrapping="Wrap" MaxHeight="32" FontSize="11"/><TextBlock Text="{Binding Status}" IsVisible="{Binding HasFeedback}" TextWrapping="Wrap" MaxHeight="36" FontSize="12"/></StackPanel>
    </Grid></Border></Grid><views:PlayerView Grid.Row="1"/>
    <Border Grid.RowSpan="2" Background="#B3080B0F" IsVisible="{Binding DestructiveConfirmation}"><Border Classes="card danger" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24"><StackPanel Spacing="12"><TextBlock Text="Confirmar alteração" Classes="heading"/><TextBlock Text="{Binding DestructivePrompt}" TextWrapping="Wrap"/><WrapPanel><Button Content="Confirmar" Classes="danger" Command="{Binding ConfirmDestructiveCommand}" Margin="0,0,8,4"/><Button Content="Cancelar" Command="{Binding CancelDestructiveCommand}" Margin="0,0,0,4"/></WrapPanel></StackPanel></Border></Border>
  </Grid>
</Window>
