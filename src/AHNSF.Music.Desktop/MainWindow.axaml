<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AHNSF.Music.Desktop" xmlns:controls="using:AHNSF.Music.Desktop.Controls" xmlns:views="using:AHNSF.Music.Desktop.Views" x:Class="AHNSF.Music.Desktop.MainWindow" Title="AHNSF Music" Width="1100" Height="760" MinWidth="900" MinHeight="620"
        Classes.densityCompact="{Binding CompactDensity}" Classes.reducedMotion="{Binding ReducedMotion}">
  <Window.KeyBindings><KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="Início"/><KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="Biblioteca"/><KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="Playlists"/><KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="Fila"/><KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="Programação"/><KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="Configurações"/><KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateCommand}" CommandParameter="Histórico"/><KeyBinding Gesture="Ctrl+8" Command="{Binding NavigateCommand}" CommandParameter="Importar músicas"/></Window.KeyBindings>
  <Window.Resources><local:CurrentTrackConverter x:Key="CurrentTrackConverter"/></Window.Resources>
  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding IsBackgroundInteractive}">
      <!-- Sidebar -->
      <Border Classes="sidebar" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="12,20,12,14">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Classes="brand" Orientation="Horizontal" Spacing="11">
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentPrimaryBrush}"><Path Classes="icon" Data="{StaticResource EqualizerIcon}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="2.4" Width="18" Height="18"/></Border>
            <StackPanel VerticalAlignment="Center" Spacing="0"><TextBlock Text="AHNSF" FontSize="16" FontWeight="Bold" LetterSpacing="0.6"/><TextBlock Text="Music" Classes="caption" FontWeight="SemiBold"/></StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="2">
              <TextBlock Text="OUVIR" Classes="eyebrow" Margin="12,4,0,6"/>
              <Button Classes="nav" Classes.active="{Binding ShowHome}" Command="{Binding NavigateCommand}" CommandParameter="Início" AutomationProperties.Name="Início" ToolTip.Tip="Início • Ctrl+1"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource HomeIcon}"/><TextBlock Grid.Column="1" Text="Início" VerticalAlignment="Center"/></Grid></Button>
              <Button Classes="nav" Classes.active="{Binding IsLibrarySection}" Command="{Binding NavigateCommand}" CommandParameter="Biblioteca" AutomationProperties.Name="Biblioteca" ToolTip.Tip="Biblioteca • Ctrl+2"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource LibraryIcon}"/><TextBlock Grid.Column="1" Text="Biblioteca" VerticalAlignment="Center"/></Grid></Button>
              <Button Classes="nav" Classes.active="{Binding IsPlaylistSection}" Command="{Binding NavigateCommand}" CommandParameter="Playlists" AutomationProperties.Name="Playlists" ToolTip.Tip="Playlists • Ctrl+3"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource PlaylistIcon}"/><TextBlock Grid.Column="1" Text="Playlists" VerticalAlignment="Center"/></Grid></Button>
              <Button Classes="nav" Classes.active="{Binding IsQueueSection}" Command="{Binding NavigateCommand}" CommandParameter="Fila" AutomationProperties.Name="Fila" ToolTip.Tip="Fila • Ctrl+4"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource QueueIcon}"/><TextBlock Grid.Column="1" Text="Fila" VerticalAlignment="Center"/></Grid></Button>
              <TextBlock Text="OPERAÇÃO" Classes="eyebrow navGroup" Margin="12,18,0,6"/>
              <Button Classes="nav" Classes.active="{Binding IsScheduleSection}" Command="{Binding NavigateCommand}" CommandParameter="Programação" AutomationProperties.Name="Programação" ToolTip.Tip="Programação • Ctrl+5"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource CalendarIcon}"/><TextBlock Grid.Column="1" Text="Programação" VerticalAlignment="Center"/></Grid></Button>
              <Button Classes="nav" Classes.active="{Binding ShowImport}" Command="{Binding NavigateCommand}" CommandParameter="Importar músicas" AutomationProperties.Name="Importar músicas" ToolTip.Tip="Importar músicas • Ctrl+8"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource ImportIcon}"/><TextBlock Grid.Column="1" Text="Importar músicas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Button>
              <Button Classes="nav" Classes.active="{Binding ShowHistory}" Command="{Binding NavigateCommand}" CommandParameter="Histórico" AutomationProperties.Name="Histórico" ToolTip.Tip="Histórico • Ctrl+7"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource HistoryIcon}"/><TextBlock Grid.Column="1" Text="Histórico" VerticalAlignment="Center"/></Grid></Button>
              <TextBlock Text="SISTEMA" Classes="eyebrow navGroup" Margin="12,18,0,6"/>
              <Button Classes="nav" Classes.active="{Binding IsSettingsSection}" Command="{Binding NavigateCommand}" CommandParameter="Configurações" AutomationProperties.Name="Configurações" ToolTip.Tip="Configurações • Ctrl+6"><Grid ColumnDefinitions="30,*"><Border Classes="navIndicator"/><Path Classes="icon" Data="{StaticResource SettingsIcon}"/><TextBlock Grid.Column="1" Text="Configurações" VerticalAlignment="Center"/></Grid></Button>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,10" Margin="0,14,0,0" ToolTip.Tip="Modo de operação. Altere em Programação.">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding ModeLabel, StringFormat='Modo {0}'}" FontWeight="SemiBold"/></StackPanel>
              <TextBlock Text="{Binding AutomationLabel}" Classes="caption tallOnly" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Operação local • Fase 0.8.3" Classes="caption tallOnly" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <!-- Page -->
      <Border Grid.Column="1" Classes="page">
        <Grid RowDefinitions="Auto,*,Auto" MaxWidth="1560">
          <Grid Classes="pageHeader" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4"><TextBlock Text="{Binding PageTitle}" Classes="title"/><TextBlock Text="{Binding PageDescription}" Classes="muted pageDescription" TextWrapping="Wrap"/></StackPanel>

          </Grid>
          <Grid Grid.Row="1">
            <views:HomeView IsVisible="{Binding ShowHome}"/>
            <views:LibraryView x:Name="LibraryPage" IsVisible="{Binding ShowLibrary}"/>
            <views:PlaylistsView x:Name="PlaylistsPage" IsVisible="{Binding ShowPlaylists}"/>
            <views:QueueView x:Name="QueuePage" IsVisible="{Binding ShowQueue}"/>
            <views:ScheduleView IsVisible="{Binding ShowSchedule}"/>
            <views:SettingsView IsVisible="{Binding ShowSettings}"/>
            <views:HistoryView IsVisible="{Binding ShowHistory}"/>
            <views:ImportView IsVisible="{Binding ShowImport}"/>
          </Grid>
          <StackPanel Grid.Row="2" Classes="pageFooter" Spacing="3"><ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" MinHeight="3"/><TextBlock Text="{Binding LibraryStatus}" Classes="caption" FontSize="11" TextWrapping="Wrap" MaxHeight="32"/><TextBlock Text="{Binding Status}" IsVisible="{Binding HasFeedback}" TextWrapping="Wrap" MaxHeight="36" FontSize="12"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <views:PlayerView Grid.Row="1" IsEnabled="{Binding IsBackgroundInteractive}"/>
    <Border x:Name="ModalOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" IsVisible="{Binding DestructiveConfirmation}" KeyboardNavigation.TabNavigation="Cycle">
      <Border Classes="card modal" Classes.danger="{Binding DialogIsDanger}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Margin="24" Padding="24" AutomationProperties.Name="{Binding DialogTitle}">
        <StackPanel Spacing="14" KeyboardNavigation.TabNavigation="Cycle">
          <TextBlock Text="{Binding DialogTitle}" Classes="heading" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DestructivePrompt}" TextWrapping="Wrap" Classes="muted" LineHeight="20"/>
          <WrapPanel HorizontalAlignment="Right" Margin="0,6,0,0"><Button x:Name="ModalCancel" Content="Cancelar" Command="{Binding CancelDestructiveCommand}" Margin="0,0,8,4" ToolTip.Tip="Esc também cancela"/><Button Content="{Binding DialogSecondaryLabel}" IsVisible="{Binding HasDialogSecondary}" Command="{Binding DialogSecondaryCommand}" Margin="0,0,8,4"/><Button x:Name="ModalConfirm" Content="{Binding DialogConfirmLabel}" Classes.danger="{Binding DialogIsDanger}" Classes.accent="{Binding !DialogIsDanger}" Command="{Binding ConfirmDestructiveCommand}" Margin="0,0,0,4"/></WrapPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
